# Copy to .env.local (gitignored) and fill in from protected deployment configuration.
# Every value here is non-secret configuration; credentials never go in this file.
# Synthesizing with these values authorizes no lookup, asset upload or deployment.

# One of dev, stg or prd. There is no default.
RAAD_ENVIRONMENT=dev
# The target account (12 digits) and the only supported region.
CDK_DEFAULT_ACCOUNT=<account-id>
CDK_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Optional guard: synthesis fails unless CDK_DEFAULT_ACCOUNT equals this account.
RAAD_EXPECTED_ACCOUNT=<account-id>

# The environment's API host and its existing us-east-1 ACM certificate (same account), together.
# The hosted-zone ID is optional: supply an existing Route 53 zone to create alias records, or
# leave it blank to point external DNS at the distribution yourself. No zone is ever created.
RAAD_DOMAIN_NAME=<env-api-host>
RAAD_HOSTED_ZONE_ID=<existing-hosted-zone-id>
RAAD_CERTIFICATE_ARN=arn:aws:acm:us-east-1:<account-id>:certificate/<certificate-id>

# The alarm destination. It lives only here and in protected CI configuration; never in source.
RAAD_ALERT_EMAIL=<alert-address>

# Sign-in is the native SDK flow (SRP) with no hosted UI, so no Cognito domain prefix is used.
# Read the deployed /raad/<env>/public-api-url output; never invent a runtime URL.

# Configure as a GitHub Environment variable only after a separately approved OIDC role exists
# for 00az/Raad. Do not reuse an unrelated role.
AWS_ROLE_ARN_DEV=
