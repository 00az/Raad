# Confirmed from the authorized AWS session on 2026-11-13.
CDK_DEFAULT_ACCOUNT=027863026273
CDK_DEFAULT_REGION=us-east-1
RAAD_ENVIRONMENT=dev

# A controlled hostname and us-east-1 custom certificate are required together.
# Leave hosted-zone ID blank for external DNS; supply only an existing zone ID.
# No hosted-zone/domain purchase is authorized. Default cloudfront.net TLS is refused.
RAAD_DOMAIN_NAME=
RAAD_HOSTED_ZONE_ID=
RAAD_CERTIFICATE_ARN=
RAAD_ALERT_EMAIL=
RAAD_COGNITO_DOMAIN_PREFIX=

# Read the deployed /raad/dev/public-api-url output; never invent a runtime URL.
# This example authorizes no provisioning, deployment or asset upload.

# Configure this as a GitHub Environment variable after creating an OIDC role
# trusted specifically for 00az/Raad. Do not reuse the existing HR app role.
AWS_ROLE_ARN_DEV=
AWS_REGION=us-east-1
